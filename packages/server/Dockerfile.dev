# Development Dockerfile for the Express + Apollo API
# Per PRD: Container + CI setup with pnpm

FROM node:20-alpine

# Match the pnpm version declared by the workspace.
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# sqlite3 is retained for data migration/debug scripts and may need a native build.
RUN apk add --no-cache python3 make g++

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.json* ./

# Install dependencies
RUN pnpm install

# Copy source code
COPY . .

# Create uploads directory
RUN mkdir -p uploads

# Expose port
EXPOSE 4000

# Development command with hot reload
CMD ["pnpm", "run", "dev"]


